# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
#
# Supabase -> project -> Connect button:
#   DATABASE_URL = "Transaction pooler" string  (port 6543)
#   DIRECT_URL   = "Session pooler" string      (port 5432)
# If your password contains @ : ! # $ % etc, URL-encode it (@ becomes %40).

DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=30"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Google AI Studio -> Get API key
GEMINI_API_KEY=""
